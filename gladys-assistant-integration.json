{
  "manifest_version": 1,
  "type": "device",
  "name": "Yoto Player Advanced",
  "description": {
    "en": "Control a Yoto Player: night light, volume, cards and sensors.",
    "fr": "Pilote un Yoto Player : veilleuse, volume, cartes et capteurs."
  },
  "version": "1.0.5",
  "docker_image": "ghcr.io/b3n0/adavanced-yoto:1.0.5",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/b3n0/Adavanced-Yoto/main/cover.png",
  "categories": ["lighting", "multimedia"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Getting started", "fr": "Pour commencer" },
      "description": {
        "en": "On the Yoto site, open Edit Application and keep Application Type on Public Client. In Allowed Callback URLs, erase the example and put only https://my.gladysassistant.com/redirect/oauth. Under Scopes, tick family:devices:control, family:devices:manage, family:view and offline_access. Rights already marked Included automatically are enough. Leave Description, Allowed Logout URLs, Application Logo and Application Privacy Policy URL empty, then click Update Application. Copy the Client ID into Identifier, save, then click Link my Yoto account.",
        "fr": "Sur le site Yoto, ouvrez Edit Application et laissez Application Type sur Public Client. Dans Allowed Callback URLs, effacez l'exemple et mettez seulement https://my.gladysassistant.com/redirect/oauth. Dans Scopes, cochez family:devices:control, family:devices:manage, family:view et offline_access. Les droits déjà marqués Included automatically suffisent. Laissez vides Description, Allowed Logout URLs, Application Logo et Application Privacy Policy URL, puis cliquez sur Update Application. Copiez le Client ID dans Identifiant, enregistrez, puis cliquez sur Lier mon compte Yoto."
      },
      "links": [
        {
          "url": "https://dashboard.yoto.dev/",
          "label": { "en": "Create a Yoto application", "fr": "Créer une application Yoto" }
        }
      ]
    },
    {
      "key": "client_id",
      "type": "string",
      "label": { "en": "Identifier", "fr": "Identifiant" },
      "description": {
        "en": "The Client ID copied from your Yoto application.",
        "fr": "Le Client ID copié depuis votre application Yoto."
      },
      "placeholder": {
        "en": "Paste the Client ID",
        "fr": "Collez le Client ID"
      },
      "required": true
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": { "en": "Secret", "fr": "Secret" },
      "description": {
        "en": "Leave empty. A Public Client has no secret.",
        "fr": "Laissez vide. Une application Public Client n'a pas de secret."
      },
      "required": false
    },
    {
      "key": "account",
      "type": "oauth2",
      "label": { "en": "Link my Yoto account", "fr": "Lier mon compte Yoto" }
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": { "en": "Player update (seconds)", "fr": "Mise à jour des lecteurs (secondes)" },
      "description": {
        "en": "How long to wait before reading the player again. 300 means 5 minutes.",
        "fr": "Délai entre deux lectures du lecteur. 300 correspond à 5 minutes."
      },
      "placeholder": { "en": "e.g. 300", "fr": "ex. 300" },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "request_status_push",
      "type": "boolean",
      "label": {
        "en": "Ask the player for a fresh status",
        "fr": "Demander un statut à jour au lecteur"
      },
      "description": {
        "en": "Before each reading, ask the player to report. Turn off if the player wakes too often.",
        "fr": "Avant chaque lecture, demande au lecteur de se signaler. Décochez si le lecteur se réveille trop souvent."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test the Yoto connection", "fr": "Tester la connexion Yoto" },
      "timeout_seconds": 30
    },
    {
      "key": "refresh_now",
      "label": { "en": "Refresh all players now", "fr": "Rafraîchir tous les lecteurs" },
      "timeout_seconds": 60
    }
  ],
  "widgets": [
    {
      "key": "players",
      "label": { "en": "Yoto players", "fr": "Lecteurs Yoto" },
      "icon": "music",
      "description": {
        "en": "Every player of the account: what it plays, its battery, online or not.",
        "fr": "Tous les lecteurs du compte : ce qu'ils jouent, leur batterie, en ligne ou non."
      },
      "action_timeout_seconds": 60
    },
    {
      "key": "player",
      "label": { "en": "Yoto player", "fr": "Lecteur Yoto" },
      "icon": "speaker",
      "description": {
        "en": "One player: battery, volume, temperature, night light and playback.",
        "fr": "Un lecteur : batterie, volume, température, veilleuse et lecture."
      },
      "settings": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "required": true
        }
      ],
      "action_timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "card_started",
      "label": {
        "en": "A card starts on a Yoto player",
        "fr": "Une carte démarre sur un lecteur Yoto"
      },
      "fields": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "description": {
            "en": "Leave empty for any player.",
            "fr": "Laissez vide pour n'importe quel lecteur."
          }
        },
        {
          "key": "card_title",
          "type": "string",
          "label": { "en": "Card title", "fr": "Titre de la carte" },
          "description": {
            "en": "Exact title, leave empty for any card.",
            "fr": "Titre exact, laissez vide pour n'importe quelle carte."
          }
        }
      ],
      "variables": [
        {
          "key": "player_name",
          "type": "string",
          "label": { "en": "Player name", "fr": "Nom du lecteur" }
        },
        {
          "key": "card_title",
          "type": "string",
          "label": { "en": "Card title", "fr": "Titre de la carte" }
        },
        {
          "key": "card_id",
          "type": "string",
          "label": { "en": "Card id", "fr": "Identifiant de la carte" }
        }
      ]
    },
    {
      "key": "card_stopped",
      "label": { "en": "A Yoto player stops playing", "fr": "Un lecteur Yoto arrête la lecture" },
      "fields": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "description": {
            "en": "Leave empty for any player.",
            "fr": "Laissez vide pour n'importe quel lecteur."
          }
        }
      ],
      "variables": [
        {
          "key": "player_name",
          "type": "string",
          "label": { "en": "Player name", "fr": "Nom du lecteur" }
        },
        {
          "key": "card_title",
          "type": "string",
          "label": { "en": "Card title", "fr": "Titre de la carte" }
        },
        {
          "key": "card_id",
          "type": "string",
          "label": { "en": "Card id", "fr": "Identifiant de la carte" }
        }
      ]
    },
    {
      "key": "battery_low",
      "label": {
        "en": "Yoto player battery low (under 20%)",
        "fr": "Batterie faible d'un lecteur Yoto (sous 20 %)"
      },
      "fields": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "description": {
            "en": "Leave empty for any player.",
            "fr": "Laissez vide pour n'importe quel lecteur."
          }
        }
      ],
      "variables": [
        {
          "key": "player_name",
          "type": "string",
          "label": { "en": "Player name", "fr": "Nom du lecteur" }
        },
        {
          "key": "battery",
          "type": "number",
          "label": { "en": "Battery (%)", "fr": "Batterie (%)" }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "play_card",
      "label": { "en": "Play a Yoto card", "fr": "Lire une carte Yoto" },
      "description": {
        "en": "Start a card on a Yoto player, from the first chapter.",
        "fr": "Démarre une carte sur un Yoto Player, au premier chapitre."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "required": true
        },
        {
          "key": "card_id",
          "type": "string",
          "label": { "en": "Card id", "fr": "Identifiant de carte" },
          "description": {
            "en": "The Yoto card id, for example 5WsQg.",
            "fr": "L'identifiant Yoto de la carte, par exemple 5WsQg."
          },
          "placeholder": { "en": "e.g. 5WsQg", "fr": "ex. 5WsQg" },
          "required": true
        },
        {
          "key": "track_index",
          "type": "number",
          "label": { "en": "Track index", "fr": "Index de la piste" },
          "description": {
            "en": "0 plays the first track of chapter 01.",
            "fr": "0 lit la première piste du chapitre 01."
          },
          "required": false,
          "default": 0,
          "min": 0,
          "max": 99
        }
      ],
      "outputs": [
        {
          "key": "playing",
          "type": "boolean",
          "label": { "en": "Playback started", "fr": "Lecture démarrée" }
        }
      ]
    },
    {
      "key": "get_player_status",
      "label": { "en": "Read a Yoto player", "fr": "Lire l'état d'un lecteur Yoto" },
      "description": {
        "en": "Reads the player now and hands its values to the next steps of the scene.",
        "fr": "Lit le lecteur maintenant et passe ses valeurs aux étapes suivantes de la scène."
      },
      "timeout_seconds": 45,
      "fields": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": { "en": "Player", "fr": "Lecteur" },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "player_name",
          "type": "string",
          "label": { "en": "Player name", "fr": "Nom du lecteur" }
        },
        { "key": "online", "type": "boolean", "label": { "en": "Online", "fr": "En ligne" } },
        {
          "key": "battery",
          "type": "number",
          "label": { "en": "Battery (%)", "fr": "Batterie (%)" }
        },
        {
          "key": "charging",
          "type": "boolean",
          "label": { "en": "Plugged in", "fr": "Sur secteur" }
        },
        { "key": "volume", "type": "number", "label": { "en": "Volume (%)", "fr": "Volume (%)" } },
        { "key": "playing", "type": "boolean", "label": { "en": "Playing", "fr": "En lecture" } },
        {
          "key": "card_title",
          "type": "string",
          "label": { "en": "Card playing", "fr": "Carte en cours" }
        },
        {
          "key": "temperature",
          "type": "number",
          "label": { "en": "Device temperature (°C)", "fr": "Température de l'appareil (°C)" }
        },
        {
          "key": "wifi_signal",
          "type": "number",
          "label": { "en": "Wi-Fi signal (dBm)", "fr": "Signal Wi-Fi (dBm)" }
        },
        {
          "key": "night_light",
          "type": "boolean",
          "label": { "en": "Night light on", "fr": "Veilleuse allumée" }
        },
        {
          "key": "brightness",
          "type": "number",
          "label": { "en": "Brightness (%)", "fr": "Luminosité (%)" }
        }
      ]
    },
    {
      "key": "refresh_players",
      "label": { "en": "Refresh all Yoto players", "fr": "Rafraîchir tous les lecteurs Yoto" },
      "description": {
        "en": "Reads every player now, without waiting for the next refresh.",
        "fr": "Lit tous les lecteurs maintenant, sans attendre le prochain rafraîchissement."
      },
      "timeout_seconds": 90,
      "outputs": [
        {
          "key": "count",
          "type": "number",
          "label": { "en": "Players refreshed", "fr": "Lecteurs rafraîchis" }
        }
      ]
    }
  ],
  "music": {}
}
